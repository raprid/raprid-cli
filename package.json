{
  "name": "raprid",
  "version": "0.4.0",
  "private": true,
  "description": "プロジェクト管理リポジトリの初期状態を生成し、管理操作を委譲する CLI",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raprid/raprid-cli.git"
  },
  "bin": {
    "raprid": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "node scripts/bundle-template.ts && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "template:sync": "node scripts/sync-template.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.3.0",
    "string-width": "8.3.0"
  }
}
